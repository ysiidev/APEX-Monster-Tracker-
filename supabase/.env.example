# Copy to supabase/.env and fill in SUPABASE_SECRET_KEY.
# .env is git-ignored — never commit the secret key.

SUPABASE_URL=https://qbhigtwejckzvocrwaqb.supabase.co

# Publishable (anon) key. Safe to expose: RLS is on with no policies, so it can read nothing.
# Kept here for reference only — the sync tool will refuse to use it.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ID0-dTZI4pQxefnWvhmmVQ_dj2p--4l

# Secret service_role key — REQUIRED for push/pull/snapshot/verify.
# Get it from: Supabase dashboard -> Project Settings -> API keys -> secret (service_role).
# Bypasses RLS and grants full read/write on your data. Keep it local.
SUPABASE_SECRET_KEY=

SUPABASE_BUCKET=monster-tracker-backups

# Optional: where push reads from / pull writes to when --data is not passed.
# APEX_DATA_FILE=%LOCALAPPDATA%\ApexMonsterTracker\data.json
